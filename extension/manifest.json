{
    "manifest_version": 3,
    "name": "SDA Integration Module",
    "version": "0.1.0",
    "description": "Download files with Super Download Agent",
    "author": "SDA Project",
    "homepage_url": "https://example.com/sda",

    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },

    "action": {
        "default_icon": "icons/icon16.png",
        "default_title": "Download with SDA"
    },

    "permissions": [
        "contextMenus",
        "tabs",
        "nativeMessaging"
    ],

    "host_permissions": [
        "<all_urls>"
    ],

    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_start",
            "all_frames": true
        }
    ],

    "externally_connectable": {
        "matches": ["*://localhost/*", "*://127.0.0.1/*"]
    },

    "optional_permissions": [
        "downloads",
        "storage"
    ]
}
